# Copiar a .env  ->  cp .env.example .env
# El .env real nunca se versiona. Los secretos de producción van por secret manager.

# ---------------------------------------------------------------- App
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------- Base de datos
# Estas variables las consume docker-compose.yml y también la URL de abajo.
POSTGRES_USER=forward
POSTGRES_PASSWORD=forward_dev
POSTGRES_DB=forward_support
# Puertos propios del proyecto, no los 5432/5433 de siempre: en una máquina de
# desarrollo casi siempre hay un Postgres local u otro proyecto ocupándolos.
POSTGRES_PORT=5442
POSTGRES_TEST_PORT=5443

DATABASE_URL=postgresql://forward:forward_dev@localhost:5442/forward_support?schema=public
DATABASE_URL_TEST=postgresql://forward:forward_dev@localhost:5443/forward_support_test?schema=public

# ---------------------------------------------------------------- Auth
# Generar cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# TTL corto a propósito: es la ventana máxima que sobrevive un usuario bloqueado.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON_MEMORY_COST=19456
# Intentos fallidos antes del bloqueo temporal, y cuánto dura ese bloqueo.
# Es distinto de status='blocked', que es administrativo.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Peticiones por minuto y por IP en los endpoints de auth. Es una defensa
# distinta del bloqueo de cuenta de arriba: esta frena a una IP martilleando,
# aquella frena un ataque repartido entre muchas IPs contra una misma cuenta.
AUTH_RATE_LIMIT_LOGIN=5
AUTH_RATE_LIMIT_REFRESH=30

# ------------------------------------------------------------------ Seed
# Contraseña de las tres cuentas de prueba (admin, supervisor y agente) que el
# seed activa sobre usuarios que YA tienen datos. Sin valor por defecto a
# propósito: el seed falla si no está, en vez de sembrar una password conocida.
SEED_PASSWORD=

# ---------------------------------------------------------------- CORS
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------- Calidad (SonarQube)
# Compose aparte: docker-compose.sonar.yml
SONAR_PORT=9000
SONAR_DB_PASSWORD=sonar_dev
# Se genera en la UI de Sonar (Account > Security > Generate token) tras el
# primer arranque. Sin token el scanner no puede publicar el análisis.
SONAR_TOKEN=
