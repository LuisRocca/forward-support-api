# Copiar a .env  ->  cp .env.example .env
# El .env real nunca se versiona. Los secretos de producción van por secret manager.

# ---------------------------------------------------------------- App
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------- Base de datos
# Estas variables las consume docker-compose.yml y también la URL de abajo.
POSTGRES_USER=forward
POSTGRES_PASSWORD=forward_dev
POSTGRES_DB=forward_support
# Puertos propios del proyecto, no los 5432/5433 de siempre: en una máquina de
# desarrollo casi siempre hay un Postgres local u otro proyecto ocupándolos.
POSTGRES_PORT=5442
POSTGRES_TEST_PORT=5443

DATABASE_URL=postgresql://forward:forward_dev@localhost:5442/forward_support?schema=public
DATABASE_URL_TEST=postgresql://forward:forward_dev@localhost:5443/forward_support_test?schema=public

# ---------------------------------------------------------------- Auth
# Generar cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# TTL corto a propósito: es la ventana máxima que sobrevive un usuario bloqueado.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_OR_ARGON_MEMORY_COST=19456

# ---------------------------------------------------------------- CORS
CORS_ORIGIN=http://localhost:5173
