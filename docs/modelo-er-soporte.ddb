    {
      "id": 2,
      "name": "users",
      "x": 60,
      "y": 640,
      "comment": "Usuarios internos (admin, supervisor, agente). No hay multi-tenant: la app es interna, los 'clientes' son datos, no inquilinos.",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "default": "gen_random_uuid()",
          "check": "",
          "primary": true,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 0
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "CITEXT o indice unico sobre lower(email) para evitar duplicados por mayusculas.",
          "id": 1
        },
        {
          "name": "password_hash",
          "type": "VARCHAR(255)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "argon2id. Nunca se selecciona en queries de lectura.",
          "id": 2
        },
        {
          "name": "full_name",
          "type": "VARCHAR(150)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 3
        },
        {
          "name": "status",
          "type": "user_status",
          "default": "'active'",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "active | blocked | inactive",
          "id": 4
        },
        {
          "name": "token_version",
          "type": "INTEGER",
          "default": "0",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "CLAVE: se incrementa al bloquear/cambiar password. El access token lleva esta version; si no coincide, se rechaza sin ir a BD.",
          "id": 5
        },
        {
          "name": "failed_login_attempts",
          "type": "SMALLINT",
          "default": "0",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 6
        },
        {
          "name": "locked_until",
          "type": "TIMESTAMPTZ",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "Bloqueo temporal automatico por fuerza bruta (distinto de status=blocked, que es administrativo).",
          "id": 7
        },
        {
          "name": "last_login_at",
          "type": "TIMESTAMPTZ",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 8
        },
        {
          "name": "blocked_at",
          "type": "TIMESTAMPTZ",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 9
        },
        {
          "name": "blocked_by_user_id",
          "type": "UUID",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "Quien bloqueo. Auto-referencia a users.",
          "id": 10
        },
        {
          "name": "blocked_reason",
          "type": "VARCHAR(255)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 11
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "default": "now()",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 12
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "default": "now()",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 13
        },
        {
          "name": "deleted_at",
          "type": "TIMESTAMPTZ",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "Soft delete: los tickets historicos deben seguir mostrando a su autor.",
          "id": 14
        }
      ],
