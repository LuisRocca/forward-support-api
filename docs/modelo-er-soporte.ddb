    {
      "id": 0,
      "name": "roles",
      "x": 60,
      "y": 80,
      "comment": "Catalogo de roles. Los permisos viven en codigo (mapa rol->permisos): hoy son estaticos y asi son testeables sin tocar BD. Migrar a role_permissions solo cuando el negocio pida permisos configurables.",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "default": "gen_random_uuid()",
          "check": "",
          "primary": true,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 0
        },
        {
          "name": "code",
          "type": "VARCHAR(50)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "admin | supervisor | agent. Clave estable usada por el guard de autorizacion.",
          "id": 1
        },
        {
          "name": "name",
          "type": "VARCHAR(100)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 2
        },
        {
          "name": "description",
          "type": "TEXT",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 3
        },
        {
          "name": "is_system",
          "type": "BOOLEAN",
          "default": "true",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "Los roles del sistema no se pueden borrar desde la UI.",
          "id": 4
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "default": "now()",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 5
        },
        {
          "name": "updated_at",
