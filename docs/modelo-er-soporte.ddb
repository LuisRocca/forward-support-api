    {
      "id": 6,
      "name": "tickets",
      "x": 900,
      "y": 80,
      "comment": "Entidad central. Campos denormalizados (last_activity_at, reassignment_count) y resolved_at/closed_at existen para responder las 7 queries sin escanear el historial.",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "default": "gen_random_uuid()",
          "check": "",
          "primary": true,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "UUIDv7 (ordenado por tiempo): mantiene localidad en el indice y no filtra cuantos tickets hay.",
          "id": 0
        },
        {
          "name": "code",
          "type": "VARCHAR(20)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "Identificador humano: TCK-000123. Es el que se dice por telefono.",
          "id": 1
        },
        {
          "name": "client_id",
          "type": "UUID",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
