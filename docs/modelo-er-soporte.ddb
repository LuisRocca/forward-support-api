    {
      "id": 3,
      "name": "refresh_tokens",
      "x": 60,
      "y": 1200,
      "comment": "Sesiones de larga vida. Es lo que permite echar a un usuario bloqueado sin esperar a que expire su JWT.",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "default": "gen_random_uuid()",
          "check": "",
          "primary": true,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 0
        },
        {
          "name": "user_id",
          "type": "UUID",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 1
        },
        {
          "name": "token_hash",
          "type": "VARCHAR(255)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": true,
          "notNull": true,
          "increment": false,
          "comment": "SHA-256 del token. Nunca se guarda el token plano: si se filtra la BD no sirve para entrar.",
          "id": 2
        },
        {
          "name": "family_id",
          "type": "UUID",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "Rotacion: si se reusa un token ya rotado se revoca la familia completa (robo detectado).",
          "id": 3
        },
        {
          "name": "expires_at",
          "type": "TIMESTAMPTZ",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 4
        },
        {
          "name": "revoked_at",
          "type": "TIMESTAMPTZ",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 5
        },
        {
          "name": "revoked_reason",
          "type": "VARCHAR(100)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "logout | rotated | user_blocked | reuse_detected",
          "id": 6
        },
        {
          "name": "ip_address",
          "type": "INET",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 7
        },
        {
          "name": "user_agent",
          "type": "VARCHAR(255)",
          "default": "",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": false,
          "increment": false,
          "comment": "",
          "id": 8
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "default": "now()",
          "check": "",
          "primary": false,
          "unique": false,
          "notNull": true,
          "increment": false,
          "comment": "",
          "id": 9
        }
      ],
      "indices": [
        {
          "id": 0,
          "name": "idx_refresh_user_active",
          "fields": [
            "user_id",
            "revoked_at"
          ],
          "unique": false
        }
      ],
      "color": "#8a5cd6"
    },
